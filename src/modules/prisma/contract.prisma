model Bucket {
  name       String   @id
  publicRead Int      @default(0) @map("public_read")
  createdAt  DateTime @map("created_at")

  objects Object[]
  uploads Upload[]
  apiKeys ApiKey[]

  @@map("buckets")
}

model Object {
  id          String   @id
  key         String
  bucketName  String   @map("bucket_name")
  bucket      Bucket   @relation(references: [name], fields: [bucketName], onDelete: Restrict, onUpdate: Restrict)
  size        Int
  contentType String   @map("content_type")
  createdAt   DateTime @map("created_at")

  @@unique([bucketName, key])
  @@map("objects")
}

model Upload {
  id          String   @id
  bucketName  String   @map("bucket_name")
  bucket      Bucket   @relation(fields: [bucketName], references: [name], onDelete: Restrict)
  key         String
  contentType String   @map("content_type")
  size        Int
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")

  @@index([bucketName])
  @@map("uploads")
}

model ApiKey {
  id         String    @id
  name       String
  tokenHash  String    @unique @map("token_hash")
  tokenHint  String?   @map("token_hint")
  bucketName String?   @map("bucket_name")
  bucket     Bucket?   @relation(references: [name], fields: [bucketName], onDelete: Cascade, onUpdate: Cascade)
  createdAt  DateTime  @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  canRead  Int @map("can_read")
  canWrite Int @map("can_write")
  isAdmin  Int @map("is_admin")

  @@map("api_keys")
}
