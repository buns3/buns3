{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    "paths": {
      "$/*": ["./src/*"]
    }
  },
  // Each workspace typechecks itself (packages/sdk has its own lib/types: DOM,
  // no Bun globals). Without this the root config compiles packages/** under
  // the SERVER's lib and fails on the SDK's DOM types.
  "exclude": [
    "node_modules",
    "packages",
    // Needs DOM for the SDK sources it imports — see tsconfig.integration.json
    "src/modules/http/__tests__/sdk-integration.test.ts"
  ]
}
